#!/usr/bin/env bash
# Which kind of calendar are we connecting?
#
# This is the front door, and it used to be the Google flow itself -- which
# meant the first thing anybody running the obvious command saw was "gws is
# required", with no hint that the calendar they actually have speaks CalDAV
# and needs nothing installed at all.
#
# Neither path is the default. A wrong guess here costs a Google Cloud project.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

choose() {
  cat <<'INTRO'
Connecting a calendar to the Omarchy Jalali calendar widget.

  1) CalDAV  -- your company mail server, Nextcloud, Radicale, Fastmail,
                iCloud, Zimbra, and most others. Usually the same host your
                IMAP account is on. Needs a server URL, a username and a
                password, and nothing installed.

  2) Google Calendar -- needs the `gws` CLI, a Google Cloud project, and four
                manual steps in the Google console. Only worth it if your
                calendar really is a Google account.

You can also skip this entirely and connect from the widget itself: click the
clock, then the gear, then the CALENDAR ACCOUNT section. That is the same
CalDAV path as option 1, without the terminal.

INTRO

  printf 'Choose 1 or 2 [1]: '
  read -r answer || true
  printf '\n'

  case "${answer:-1}" in
    1|caldav|CalDAV|c) exec "$SCRIPT_DIR/setup-caldav" "$@" ;;
    2|google|Google|g) exec "$SCRIPT_DIR/setup-google" "$@" ;;
    *) echo "Not an option: $answer" >&2; exit 1 ;;
  esac
}

# A non-interactive run cannot be asked, and picking one for it would be
# guessing with someone else's Google Cloud account.
if [ ! -t 0 ]; then
  cat >&2 <<'EOF2'
This picks between two setups and stdin is not a terminal, so it cannot ask.

  CalDAV (your mail server, Nextcloud, Radicale, Fastmail, iCloud):
    sync/setup-caldav

  Google Calendar:
    sync/setup-google
EOF2
  exit 1
fi

choose "$@"
