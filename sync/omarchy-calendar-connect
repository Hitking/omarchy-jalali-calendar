#!/usr/bin/env python3
"""Executable wrapper for the CalDAV connect, so it runs straight from the checkout.

Reads one JSON request on stdin, writes one JSON result on stdout. Both the
settings panel and sync/setup-caldav go through this, so there is a single
implementation of "connect an account" rather than one per front end.

    printf '{"url":"https://mail.example.com/","username":"me@example.com","password":"..."}' \
      | sync/omarchy-calendar-connect
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

# Python writes its bytecode cache next to the source it imports, which here
# means inside the plugin folder. Omarchy's shell watches that folder and
# reloads the plugin when anything in it changes -- unloading the panel, and
# killing whatever the panel is running. So merely starting this from the
# settings page rewrote the folder, tore the panel down, and took the connect
# with it. The cache goes to the user's cache directory instead, which is
# where a cache belongs and which nothing is watching.
#
# Set before the package is imported: after that, the writing has happened.
_cache = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
sys.pycache_prefix = str(Path(_cache) / "omarchy-jalali-calendar" / "pycache")

from omarchy_calendar_sync.connect import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
