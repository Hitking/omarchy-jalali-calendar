#!/usr/bin/env bash
# Interactive setup for the CalDAV sync: company mail servers, Nextcloud,
# Radicale, Fastmail, iCloud, or anything else that speaks the standard.
#
# Unlike the Google flow next door, this needs nothing from a cloud console:
# a URL, a username and a password is the whole of it.
#
# This script is now only a set of prompts. Verifying the credentials, storing
# the password, writing the config, installing the timer and running the first
# sync all happen in omarchy_calendar_sync/connect.py, which is also what the
# widget's own settings page calls. Two front ends, one implementation -- so
# fixing something here cannot leave the panel behind, and the connect logic
# is covered by tests rather than living in a shell script nobody can test.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONNECT_BIN="$SCRIPT_DIR/omarchy-calendar-connect"

step() { printf '\n==> %s\n' "$1"; }
fail() { printf '\nerror: %s\n' "$1" >&2; exit 1; }

command -v python3 >/dev/null || fail "python3 is required"

if [ ! -t 0 ]; then
  fail "run this in a terminal: it asks for a server, a username and a password"
fi

cat <<'INTRO'
Connecting a CalDAV calendar.

You need three things:

  1. The server URL: the mail server root, the same host your IMAP account
     and webmail are on, for example https://mail.example.com/ -- not the
     webmail path, and not a calendar-specific URL. The rest is discovered
     by asking the server.
  2. Your username, usually the full email address.
  3. Your password. If the account has two-factor authentication, this must
     be an application-specific password, not the account password: CalDAV
     has no way to prompt for a second factor.

The widget can do all of this itself -- click the clock, then the gear. This
script exists for anyone who would rather stay in the terminal.

INTRO

step "Server URL"
read -r -p "  URL [https://mail.example.com/]: " SERVER_URL
[ -n "$SERVER_URL" ] || fail "a server URL is required"

step "Username"
read -r -p "  username (usually your email address): " USERNAME
[ -n "$USERNAME" ] || fail "a username is required"

step "Password"
# -s so it is not echoed, and never passed as an argument: an argument is
# visible in ps to every process on the machine. It goes over stdin instead.
read -r -s -p "  password: " PASSWORD
printf '\n'
[ -n "$PASSWORD" ] || fail "a password is required"

step "Certificate check"
# An on-premise mail server with a private CA is a real situation, and the
# alternative to asking is the user disabling verification wholesale in a
# config file they found on a forum.
read -r -p "  verify the TLS certificate? [Y/n]: " VERIFY
case "${VERIFY:-y}" in
  n | N | no | NO) VERIFY_TLS=false ;;
  *) VERIFY_TLS=true ;;
esac

step "Connecting"
echo "  checking the credentials, then writing the config and the timer"

# One JSON object in, one JSON result out. The password travels down this pipe
# and is never an argument: argv is world-readable through ps, while the
# environment of the small builder below is readable only by this same user.
result=$(
  SERVER_URL="$SERVER_URL" USERNAME="$USERNAME" PASSWORD="$PASSWORD" \
  VERIFY_TLS="$VERIFY_TLS" python3 - <<'REQUEST' | "$CONNECT_BIN"
import json, os, sys

json.dump({
    "url": os.environ["SERVER_URL"],
    "username": os.environ["USERNAME"],
    "password": os.environ["PASSWORD"],
    "verifyTls": os.environ["VERIFY_TLS"] == "true",
}, sys.stdout)
REQUEST
) || true

RESULT="$result" python3 - <<'REPORT' || fail "could not connect"
import json, os, sys

raw = os.environ["RESULT"].strip()
if not raw:
    print("  the connect helper said nothing at all", file=sys.stderr)
    raise SystemExit(1)

try:
    result = json.loads(raw)
except ValueError:
    print("  unreadable reply from the connect helper:", raw, file=sys.stderr)
    raise SystemExit(1)

if not result.get("ok"):
    stage = result.get("stage", "")
    print("  failed at the", stage, "stage:", result.get("error"), file=sys.stderr)
    if stage == "credentials":
        print("  nothing was written. Check the URL, username and password.", file=sys.stderr)
    raise SystemExit(1)

calendars = result.get("calendars", [])
print("  found", len(calendars), "calendar(s):")
for calendar in calendars:
    print("    -", calendar["name"], " ", calendar["color"])
print("  config:     ", result.get("configPath"))
print("  timer:      ", result.get("timer"))
print("  first sync: ", result.get("firstSync"))
REPORT

cat <<'DONE'

Done. Events land in ~/.local/state/omarchy/calendar-events.json every five
minutes and the widget picks them up without a restart.

  Choose which calendars to show: click the clock, then the gear icon.
  If the calendar goes quiet later:

    journalctl --user -u omarchy-calendar-sync -f
DONE
