{
  "schemaVersion": 1,
  "id": "masoud.jalali-calendar",
  "name": "Jalali Calendar",
  "version": "0.1.0",
  "author": "masoud",
  "license": "MIT",
  "description": "تقویم شمسی (جلالی) در نوار اُمارچی، با رویدادهای گوگل کلندر — A Jalali (Solar Hijri) calendar in the Omarchy bar, with your real events on it.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Jalali Calendar",
    "description": "تقویم شمسی (جلالی) در نوار اُمارچی — a Jalali calendar and clock with your real events on it.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "dddd d MMMM yyyy",
      "verticalFormat": "HH\n—\nmm",
      "fontFamily": "Vazirmatn"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "قالب تاریخ",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "قالب جایگزین",
        "defaultValue": "dddd d MMMM yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "قالب نوار عمودی",
        "defaultValue": "HH\n—\nmm"
      },
      {
        "key": "fontFamily",
        "type": "string",
        "label": "فونت",
        "defaultValue": "Vazirmatn"
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "سال تولد (شمسی)",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "امید به زندگی",
        "defaultValue": 0
      }
    ]
  }
}
